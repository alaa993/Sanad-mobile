<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sanad_surface"
    android:fitsSystemWindows="true">

    <FrameLayout
        android:id="@+id/hero"
        android:layout_width="0dp"
        android:layout_height="170dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_sanad_header_gradient" />

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY"
            android:src="@drawable/bg_header_wave" />
    </FrameLayout>
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        app:navigationIcon="@drawable/ic_chevron_left"
        app:navigationIconTint="@color/sanad_on_primary"
        app:title="@string/menu_change_theme"
        app:titleTextColor="@color/sanad_on_primary" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardTheme"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="-36dp"
        app:cardCornerRadius="26dp"
        app:cardElevation="10dp"
        app:strokeColor="@color/sanad_button_stroke"
        app:strokeWidth="1dp"
        app:layout_constraintTop_toBottomOf="@id/hero"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/sanad_surface"
            android:padding="20dp">

            <TextView
                android:id="@+id/tvThemeTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/menu_theme"
                android:textColor="@color/sanad_on_bg"
                android:textSize="16sp"
                android:textStyle="bold" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="16dp"
                android:background="@color/sanad_button_stroke" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnThemeBlue"
                style="@style/Sanad.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/theme_blue" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnThemeGray"
                style="@style/Sanad.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/theme_gray" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnThemePink"
                style="@style/Sanad.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/theme_pink" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>

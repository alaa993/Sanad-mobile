<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sanad_surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="156dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="fitXY"
                android:src="@drawable/bg_header_wave" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="top"
                android:orientation="vertical"
        android:paddingTop="18dp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingBottom="40dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/fragment_sessions_text_1"
                    android:textColor="@color/sanad_on_primary"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:maxLines="2"
                    android:ellipsize="end" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/sessions_header_subtitle"
                    android:textColor="@color/sanad_surface_alt"
                    android:textSize="13sp" />
            </LinearLayout>
        </FrameLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:id="@+id/content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="20dp"
                    app:cardBackgroundColor="@color/sanad_surface_alt"
                    app:strokeColor="@color/sanad_button_stroke"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnBookSession"
                                style="@style/Sanad.Button.Outline"
                                android:layout_width="0dp"
                                android:layout_height="56dp"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:maxLines="2"
                                android:textAlignment="center"
                                android:text="@string/cta_new_session" />

                            <Space
                                android:layout_width="12dp"
                                android:layout_height="1dp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnGroupSessions"
                                style="@style/Sanad.Button.Outline"
                                android:layout_width="0dp"
                                android:layout_height="56dp"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:maxLines="2"
                                android:textAlignment="center"
                                android:text="@string/sessions_group_cta" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="20dp"
                    app:cardBackgroundColor="@color/sanad_surface">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/sessions_filter_title"
                            android:textColor="@color/sanad_on_bg"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/groupStatus"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            app:singleSelection="true"
                            app:selectionRequired="true">

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipAll"
                                style="@style/Widget.Material3.Chip.Filter"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/sessions_filter_all"
                                android:checkable="true"
                                android:checked="true"
                                android:tag="all" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipPending"
                                style="@style/Widget.Material3.Chip.Filter"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/sessions_filter_pending"
                                android:checkable="true"
                                android:tag="pending" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipAccepted"
                                style="@style/Widget.Material3.Chip.Filter"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/sessions_filter_accepted"
                                android:checkable="true"
                                android:tag="accepted" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipCompleted"
                                style="@style/Widget.Material3.Chip.Filter"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/sessions_filter_completed"
                                android:checkable="true"
                                android:tag="completed" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipCanceled"
                                style="@style/Widget.Material3.Chip.Filter"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/sessions_filter_canceled"
                                android:checkable="true"
                                android:tag="canceled" />
                        </com.google.android.material.chip.ChipGroup>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnClearFilters"
                                style="@style/Sanad.Button.Tonal"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/sessions_filter_clear" />

                            <Space
                                android:layout_width="8dp"
                                android:layout_height="1dp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnPickDate"
                                style="@style/Sanad.Button.Outline"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:minWidth="0dp"
                                android:text="@string/sessions_filter_date_pick" />

                            <!-- Shown only after the user picks a date range -->
                            <TextView
                                android:id="@+id/tvDateRange"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="10dp"
                                android:layout_weight="1"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:textColor="@color/sanad_input_hint"
                                android:textSize="12sp"
                                android:visibility="gone" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:id="@+id/tvPendingHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/sessions_section_pending"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:textColor="@color/sanad_primary"
                    android:paddingBottom="8dp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvPending"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false" />

                <TextView
                    android:id="@+id/emptyPending"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/sessions_empty_pending"
                    android:textAlignment="center"
                    android:textColor="@color/sanad_input_hint"
                    android:padding="12dp"
                    android:visibility="gone" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="20dp" />

                <TextView
                    android:id="@+id/tvAcceptedHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/sessions_section_accepted"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:textColor="@color/sanad_primary"
                    android:paddingBottom="8dp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvAccepted"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false" />

                <TextView
                    android:id="@+id/emptyAccepted"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/sessions_empty_accepted"
                    android:textAlignment="center"
                    android:textColor="@color/sanad_input_hint"
                    android:padding="12dp"
                    android:visibility="gone" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="20dp" />

                <TextView
                    android:id="@+id/tvCompletedHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/sessions_section_completed"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:textColor="@color/sanad_primary"
                    android:paddingBottom="8dp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvCompleted"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false" />

                <TextView
                    android:id="@+id/emptyCompleted"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/sessions_empty_completed"
                    android:textAlignment="center"
                    android:textColor="@color/sanad_input_hint"
                    android:padding="12dp"
                    android:visibility="gone" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="20dp" />

                <TextView
                    android:id="@+id/tvRejectedHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/sessions_section_rejected"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:textColor="@color/sanad_primary"
                    android:paddingBottom="8dp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvRejected"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false" />

                <TextView
                    android:id="@+id/emptyRejected"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/sessions_empty_rejected"
                    android:textAlignment="center"
                    android:textColor="@color/sanad_input_hint"
                    android:padding="12dp"
                    android:visibility="gone" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="24dp" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <!-- طبقة التحميل -->
    <LinearLayout
        android:id="@+id/progress"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:background="#55FFFFFF"
        android:visibility="gone">
        <ProgressBar
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>

    <!-- طبقة الخطأ -->
    <LinearLayout
        android:id="@+id/errorContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvError"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/fragment_sessions_text_6"
            android:textColor="@color/sanad_primary"
            android:textStyle="bold"
            android:paddingBottom="12dp" />

        <Button
            android:id="@+id/btnRetry"
            style="@style/Sanad.PrimaryButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/fragment_sessions_text_7" />
    </LinearLayout>

</FrameLayout>

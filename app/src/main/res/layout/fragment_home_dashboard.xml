<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/swipeRefresh"
    android:layout_width="match_parent"
    android:background="@color/sanad_canvas"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/content"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:fillViewport="true"
            android:fitsSystemWindows="true"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="32dp">

                <FrameLayout
                    android:id="@+id/hero"
                    android:layout_width="match_parent"
                    android:layout_height="170dp">



                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:adjustViewBounds="true"
                        android:scaleType="fitXY"
                        android:src="@drawable/bg_header_wave" />

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:paddingStart="20dp"
                            android:paddingTop="32dp"
                            android:paddingEnd="20dp"
                            android:paddingBottom="12dp">

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/headerBlock"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent">

                            <ImageView
                                android:id="@+id/profileImage"
                                    android:layout_width="64dp"
                                    android:layout_height="64dp"
                                    android:background="@drawable/bg_circle_surface"
                                    android:padding="8dp"
                                    android:scaleType="centerCrop"
                                    android:src="@drawable/ic_profile"
                                    android:visibility="gone"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent" />

                            <LinearLayout
                                android:id="@+id/headerTexts"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="14dp"
                                android:orientation="vertical"
                                app:layout_constraintBottom_toBottomOf="@id/profileImage"
                                app:layout_constraintStart_toEndOf="@id/profileImage"
                                app:layout_constraintTop_toTopOf="@id/profileImage">

                                <TextView
                                    android:id="@+id/tvRole"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/patient_title"
                                    android:textColor="@color/sanad_on_primary"
                                    android:textSize="24sp"
                                    android:textStyle="bold"
                                    android:visibility="visible"/>

                                <TextView
                                    android:id="@+id/tvGreeting"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="6dp"
                                    android:text="@string/patient_greeting"
                                    android:textColor="@color/sanad_on_primary"
                                    android:textSize="15sp" />
                            </LinearLayout>

                            <com.google.android.material.floatingactionbutton.FloatingActionButton
                                android:id="@+id/btnBell"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:tint="@color/sanad_on_primary"
                                app:backgroundTint="@android:color/transparent"
                                app:borderWidth="0dp"
                                app:elevation="0dp"
                                app:pressedTranslationZ="0dp"
                                app:fabCustomSize="48dp"
                                app:fabSize="mini"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintTop_toTopOf="parent"
                                app:srcCompat="@drawable/ic_notifications" />
                        </androidx.constraintlayout.widget.ConstraintLayout>

                        <TextView
                            android:id="@+id/heroSubtitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:text="@string/dashboard_intro_subtitle"
                            android:textColor="@color/sanad_on_primary"
                            android:textSize="15sp"
                            app:layout_constraintTop_toBottomOf="@id/headerBlock"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent" />

                    </androidx.constraintlayout.widget.ConstraintLayout>
                </FrameLayout>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardHeroStats"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:layout_marginTop="-28dp"
                    android:layout_marginBottom="12dp"
                    app:cardBackgroundColor="@color/sanad_surface_alt"
                    app:cardElevation="8dp"
                    app:strokeColor="@color/sanad_button_stroke"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="16dp"
                        android:weightSum="3">

                        <LinearLayout
                            android:id="@+id/statUpcoming"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:clickable="true"
                            android:contentDescription="@string/desc_upcoming"
                            android:focusable="true"
                            android:gravity="center"
                            android:orientation="vertical">

                            <ImageView
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:layout_marginBottom="6dp"
                                android:src="@drawable/ic_calendar" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/dashboard_next_sessions"
                                android:textColor="@color/sanad_neutral"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/tvUpcoming"
                                style="@style/Sanad.StatNumber"
                                android:layout_marginTop="2dp"
                                android:text="@string/fragment_home_dashboard_text_1" />
                        </LinearLayout>

                        <View
                            android:layout_width="1dp"
                            android:layout_height="48dp"
                            android:layout_marginHorizontal="8dp"
                            android:background="#1E2F55A5" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                            <ImageView
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:layout_marginBottom="6dp"
                                android:src="@drawable/ic_unread" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/dashboard_unread"
                                android:textColor="@color/sanad_neutral"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/tvUnread"
                                style="@style/Sanad.StatNumber"
                                android:layout_marginTop="2dp"
                                android:text="@string/fragment_home_dashboard_text_2" />
                        </LinearLayout>

                        <View
                            android:layout_width="1dp"
                            android:layout_height="48dp"
                            android:layout_marginHorizontal="8dp"
                            android:background="#1E2F55A5" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                            <ImageView
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:layout_marginBottom="6dp"
                                android:src="@drawable/ic_star" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/dashboard_points"
                                android:textColor="@color/sanad_neutral"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/tvPoints"
                                style="@style/Sanad.StatNumber"
                                android:layout_marginTop="2dp"
                                android:text="@string/fragment_home_dashboard_text_3" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="20dp"
                    android:paddingTop="4dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPrimaryAction"
                        style="@style/Sanad.Button.Outline"
                        android:layout_width="match_parent"

                        android:layout_height="wrap_content"

                        android:layout_marginTop="12dp"
                        android:text="@string/cta_new_session" />

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardNextSession"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="8dp"
                        app:cardElevation="8dp"
                        app:strokeColor="@color/sanad_chip_bg"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:background="@color/sanad_surface"
                            android:padding="20dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <ImageView
                                    android:id="@+id/imgSpecialist"
                                    android:layout_width="60dp"
                                    android:layout_height="60dp"
                                    android:background="@drawable/bg_circle_surface"
                                    android:padding="8dp"
                                    android:src="@drawable/ic_specialists"
                                    android:visibility="gone" />

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="16dp"
                                    android:layout_weight="1"
                                    android:orientation="vertical">

                                    <TextView
                                        android:id="@+id/tvNextTitle"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="@string/next_session_title"
                                        android:textColor="@color/sanad_on_bg"
                                        android:textSize="17sp"
                                        android:textStyle="bold" />

                                    <TextView
                                        android:id="@+id/tvNextType"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="2dp"
                                        android:text="@string/next_session_type_placeholder"
                                        android:textColor="@color/sanad_neutral"
                                        android:textSize="13sp" />

                                    <TextView
                                        android:id="@+id/tvNextTime"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="@string/next_session_time_placeholder"
                                        android:textColor="@color/sanad_neutral"
                                        android:textSize="13sp" />
                                </LinearLayout>

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnJoin"
                                    style="@style/Sanad.Button.Outline"
                                    android:layout_width="wrap_content"
                                    android:layout_height="44dp"

                                    android:text="@string/cta_join_now" />
                            </LinearLayout>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:id="@+id/tvNoNext"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:padding="12dp"
                        android:text="@string/no_next_session"
                        android:textColor="@color/sanad_neutral"
                        android:visibility="gone" />

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardOnboarding"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:visibility="gone"
                        app:cardElevation="6dp"
                        app:strokeColor="@color/sanad_button_stroke"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:background="@color/sanad_surface"
                            android:padding="18dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/onboarding_steps_title"
                                android:textColor="@color/sanad_on_bg"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <LinearLayout
                                android:id="@+id/onboardingSteps"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:orientation="vertical" />

                            <TextView
                                android:id="@+id/tvJournalUnlocked"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text="@string/onboarding_journal_unlocked"
                                android:textColor="@color/sanad_primary"
                                android:textSize="13sp"
                                android:visibility="gone" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardIntake"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        app:cardElevation="6dp"
                        app:strokeColor="@color/sanad_button_stroke"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:background="@color/sanad_surface"
                            android:padding="18dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/home_intake_title"
                                android:textColor="@color/sanad_on_bg"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvIntakeStatus"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:text="@string/home_intake_updated"
                                android:textColor="@color/sanad_neutral"
                                android:textSize="13sp" />

                            <TextView
                                android:id="@+id/tvIntakeSeverity"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text="@string/home_intake_severity"
                                android:textColor="@color/sanad_on_bg"
                                android:textSize="14sp" />

                            <TextView
                                android:id="@+id/tvIntakeImpact"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/home_intake_impact"
                                android:textColor="@color/sanad_on_bg"
                                android:textSize="14sp" />

                            <TextView
                                android:id="@+id/tvIntakePreferred"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/home_intake_preferred"
                                android:textColor="@color/sanad_on_bg"
                                android:textSize="14sp" />

                            <TextView
                                android:id="@+id/tvIntakeRisk"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/home_intake_risk"
                                android:textColor="@color/sanad_on_bg"
                                android:textSize="14sp" />

                            <TextView
                                android:id="@+id/tvIntakeSpecialist"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/home_intake_specialist"
                                android:textColor="@color/sanad_on_bg"
                                android:textSize="14sp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnIntakeOpen"
                                style="@style/Sanad.Button.Outline"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:layout_gravity="center"
                                android:text="@string/home_intake_open" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardPhysicianReferral"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:visibility="gone"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="6dp"
                        app:strokeColor="@color/sanad_button_stroke"
                        app:strokeWidth="1dp">

                        <TextView
                            android:id="@+id/tvPhysicianReferral"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:padding="16dp"
                            android:text="@string/physician_referral_banner"
                            android:textColor="@color/sanad_primary"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardTools"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="6dp"
                        app:strokeColor="@color/sanad_button_stroke"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:visibility="gone"
                            android:padding="14dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/dashboard_tools_title"
                                android:textColor="@color/sanad_on_bg"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:orientation="vertical">

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnToolGuide"
                                    style="@style/Sanad.Button.Tonal"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center_horizontal"
                                    android:text="@string/dashboard_tool_guide"
                                    app:icon="@drawable/ic_library"
                                    app:iconPadding="8dp" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnToolAccessibility"
                                    style="@style/Sanad.Button.Tonal"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center_horizontal"
                                    android:layout_marginTop="8dp"
                                    android:text="@string/dashboard_tool_accessibility"
                                    app:icon="@drawable/ic_profile"
                                    app:iconPadding="8dp" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnToolSupport"
                                    style="@style/Sanad.Button.Tonal"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center_horizontal"
                                    android:layout_marginTop="8dp"
                                    android:text="@string/dashboard_tool_support"
                                    app:icon="@drawable/ic_chat"
                                    app:iconPadding="8dp" />
                            </LinearLayout>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <ProgressBar
            android:id="@+id/progress"
            style="?android:attr/progressBarStyleLarge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <LinearLayout
            android:id="@+id/errorContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp"
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/error_fetch_data"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRetry"
                style="@style/Sanad.Button.Outline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
                android:layout_marginTop="12dp"
                android:text="@string/cta_retry" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
  <item>
    <shape android:shape="rectangle">
      <solid android:color="@color/sanad_primary"/>
    </shape>
  </item>
  <item android:gravity="top|center_horizontal" android:top="120dp">
    <shape>
      <size android:width="320dp" android:height="320dp"/>
      <gradient
          android:type="radial"
          android:gradientRadius="160dp"
          android:startColor="#40FFFFFF"
          android:centerColor="#20FFFFFF"
          android:endColor="#00FFFFFF"/>
    </shape>
  </item>
</layer-list>
